# ARCADINS — Variables d'environnement QA (modèle). Copier vers .env.qa.local.
# ⚠️ Environnement de TEST uniquement — NE JAMAIS pointer vers la base de PRODUCTION.

# ── Supabase QA (projet de test OU instance locale `supabase start`) ──────────
NEXT_PUBLIC_SUPABASE_URL=            # ex. http://127.0.0.1:54321 (local) ou https://<projet-qa>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # clé anon du projet QA (PUBLIQUE — non « Sensitive »)
SUPABASE_SERVICE_ROLE_KEY=          # clé service role QA (privée)

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email : mode console en QA (aucun envoi réel) ────────────────────────────
EMAIL_PROVIDER=console

# ── Stripe TEST (mode test — clés sk_test_ / whsec_ ; aucune transaction réelle) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxx

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=qa-cron-secret-change-me

# ── Playwright — comptes de test seedés par supabase/seed_qa.sql ─────────────
E2E_BASE_URL=http://localhost:3000
E2E_STUDENT_EMAIL=qa.student@arcadins.test
E2E_STUDENT_PASSWORD=ArcadinsQA!2026
E2E_ADMIN_EMAIL=qa.admin@arcadins.test
E2E_ADMIN_PASSWORD=ArcadinsQA!2026
E2E_TUTOR_EMAIL=qa.tutor@arcadins.test
E2E_TUTOR_PASSWORD=ArcadinsQA!2026
