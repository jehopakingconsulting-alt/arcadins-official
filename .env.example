# ARCADINS — variables d'environnement (modèle). Copier vers .env.local et
# remplir. NE JAMAIS committer de vraies clés (.env.local est ignoré par git).
# Liste alignée sur l'usage réel du code (audit process.env). Voir ENVIRONMENT_SETUP.md.

# ── Supabase (obligatoire) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (obligatoire) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── Notifications / courriel ────────────────────────────────────────────────
# console (défaut dev, aucun envoi) | resend (production)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Stripe (obligatoire en production) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Tâches planifiées (Vercel Cron) ─────────────────────────────────────────
# OBLIGATOIRE en production : valeur longue et aléatoire. Protège
# /api/cron/expire-pending (l'endpoint est refusé si cette variable est vide).
CRON_SECRET=

# ── Rate limiting distribué (optionnel — repli mémoire si absent) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observabilité OpenTelemetry (optionnel — inactif si absent) ──────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arcadins
