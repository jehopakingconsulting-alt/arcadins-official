# ARCADINS — variables d'environnement (modèle). Copier vers .env.local et
# remplir. NE JAMAIS committer de vraies clés (.env.local est ignoré par git).

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
APP_URL=

# ── Notifications / courriel ────────────────────────────────────────────────
# console (défaut dev, aucun envoi) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Stripe (déjà en place) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
