# ARCADINS — variables d'environnement (modèle). Copier vers .env.local et
# remplir. NE JAMAIS committer de vraies clés (.env.local est ignoré par git).
# Liste alignée sur l'usage réel du code (audit process.env). Voir ENVIRONMENT_SETUP.md.

# ── Supabase (obligatoire) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (obligatoire) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── Notifications / courriel ────────────────────────────────────────────────
# console (défaut dev, aucun envoi) | resend (API HTTP, recommandé) | smtp (nodemailer)
EMAIL_PROVIDER=console
# Identité expéditeur — DOIT être un domaine vérifié (SPF/DKIM). Ex : "ARCADINS <no-reply@arcadins-training.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=
# Adresse interne recevant les notifications du formulaire de contact.
CONTACT_NOTIFY_TO=
# URL publique (liens des e-mails).
APP_URL=https://arcadins-official.vercel.app
# --- Option A : Resend (EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=
# --- Option B : SMTP littéral (EMAIL_PROVIDER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Stripe (obligatoire en production) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Tâches planifiées (Vercel Cron) ─────────────────────────────────────────
# OBLIGATOIRE en production : valeur longue et aléatoire. Protège
# /api/cron/expire-pending (l'endpoint est refusé si cette variable est vide).
CRON_SECRET=

# ── Rate limiting distribué (optionnel — repli mémoire si absent) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observabilité OpenTelemetry (optionnel — inactif si absent) ──────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arcadins
